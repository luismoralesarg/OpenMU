# Copy this file to .env (same directory) and fill in real values.
# .env is gitignored - never commit real secrets here.

# Signs the JWTs mu-api issues on /mobile/login. Any long random string.
MU_API_JWT_SECRET=

# Shared secret between mu-api and the OpenMU plugin
# (PlugIns.MuApiBridge). Must match the WebhookSecret configured on the
# plugins in the AdminPanel -> Plugins page - otherwise mu-api rejects
# their webhook calls with 401.
MU_API_WEBHOOK_SECRET=

# Path ON THE HOST to the Firebase service account JSON (Firebase console
# -> Project settings -> Service accounts -> Generate new private key).
# Defaults to /root/secrets/firebase-credentials.json if unset.
MU_API_FIREBASE_CREDENTIALS_PATH=/root/secrets/firebase-credentials.json

# reCAPTCHA v2 ("I'm not a robot" checkbox) keys from
# https://www.google.com/recaptcha/admin - protects POST /mobile/register
# from bots. Leave both empty to disable self-service registration
# (the endpoint returns 503 instead of failing mu-api's startup).
MU_API_RECAPTCHA_SITE_KEY=
MU_API_RECAPTCHA_SECRET_KEY=
